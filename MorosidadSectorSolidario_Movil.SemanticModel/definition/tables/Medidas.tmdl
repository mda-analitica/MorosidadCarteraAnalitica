	/// Número de entidades con dato en tasa de riesgo que cumplen los filtros de la página (sin «Entidades a comparar»).
	measure 'Entidades ranking tasa riesgo' =
			VAR Universo =
			    FILTER(
			        CALCULATETABLE(
			            ADDCOLUMNS(VALUES(dm_Entidades[CODIGO ENTIDAD]), "@v", [Tasa riesgo]),
			            REMOVEFILTERS(dm_Entidades[SIGLA])
			        ),
			        NOT ISBLANK([@v])
			    )
			RETURN
			    COUNTROWS(Universo)
		formatString: 0
		lineageTag: 5ebabf24-181e-044a-4893-968d9785a111

	measure 'Texto ranking tasa riesgo' =
			VAR Nombre = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA])
			VAR Pos = [Ranking tasa riesgo]
			VAR Total = [Entidades ranking tasa riesgo]
			RETURN
			    SWITCH(
			        TRUE(),
