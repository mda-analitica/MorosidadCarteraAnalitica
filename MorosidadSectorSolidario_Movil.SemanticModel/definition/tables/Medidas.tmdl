	/// Cobertura individual CDE de las entidades elegidas en el segmentador de entidad seleccionada.
	measure 'Cobertura individual CDE con entidad seleccionada' = CALCULATE([Cobertura individual CDE], TREATAS(VALUES(dm_EntidadSeleccionada[CODIGO ENTIDAD]), tb_Balance[CODIGO ENTIDAD]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1e1293b9-07e3-5976-b940-963b6206185b

	/// Último corte disponible en el modelo (independiente de los filtros del informe).
	measure 'Fecha de corte' = CALCULATE(MAX(tb_Balance[Fecha reporte]), REMOVEFILTERS())
		formatString: d/MM/yyyy
		lineageTag: 371ccc61-be38-8c98-e49b-bd9f8f32b97c

	measure 'Fecha de corte texto' = "Datos a " & FORMAT([Fecha de corte], "MMMM ""de"" yyyy")
		lineageTag: 663a3447-1a38-7c24-4363-4d106ffa9f19

	/// Fecha que publica la Supersolidaria en la página de entidades vigiladas que reportan información.
	measure 'Fecha Supersolidaria texto' =
			VAR f = MAX('Fecha Supersolidaria'[Fecha publicación])
			RETURN
			    IF(
			        ISBLANK(f),
			        "Supersolidaria: fecha de publicación no disponible",
			        "Supersolidaria publicó el " & FORMAT(f, "d ""de"" MMMM ""de"" yyyy")
			    )
		lineageTag: f02a7fe4-a5b8-2ad1-2d16-83f02abf5046
	/// Posición de la entidad de «Su entidad cooperativa» en tasa de mora (1 = la más baja).
	/// Universo: entidades con dato que cumplen los filtros de la página, sin el filtro de «Entidades a comparar».
	measure 'Ranking tasa mora' =
			VAR Sel = SELECTEDVALUE(dm_EntidadSeleccionada[CODIGO ENTIDAD])
			VAR ValorSel = CALCULATE([Tasa mora], REMOVEFILTERS(dm_Entidades[SIGLA]), dm_Entidades[CODIGO ENTIDAD] = Sel)
			VAR Universo =
			    FILTER(
			        CALCULATETABLE(
			            ADDCOLUMNS(VALUES(dm_Entidades[CODIGO ENTIDAD]), "@v", [Tasa mora]),
			            REMOVEFILTERS(dm_Entidades[SIGLA])
			        ),
			        NOT ISBLANK([@v])
			    )
			RETURN
			    IF(NOT ISBLANK(Sel) && NOT ISBLANK(ValorSel), COUNTROWS(FILTER(Universo, [@v] < ValorSel)) + 1)
		formatString: 0
		lineageTag: 5ef14f1b-9f00-fc3a-94f9-8ff38e99afba

	/// Número de entidades con dato en tasa de mora que cumplen los filtros de la página (sin «Entidades a comparar»).
	measure 'Entidades ranking tasa mora' =
			VAR Universo =
			    FILTER(
			        CALCULATETABLE(
			            ADDCOLUMNS(VALUES(dm_Entidades[CODIGO ENTIDAD]), "@v", [Tasa mora]),
			            REMOVEFILTERS(dm_Entidades[SIGLA])
			        ),
			        NOT ISBLANK([@v])
			    )
			RETURN
			    COUNTROWS(Universo)
		formatString: 0
		lineageTag: 5ddcb5bb-fdb3-224c-2ec3-c3f482b1b851

	measure 'Texto ranking tasa mora' =
			VAR Nombre = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA])
			VAR Pos = [Ranking tasa mora]
			VAR Total = [Entidades ranking tasa mora]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Nombre), "Elige tu entidad en «Su entidad cooperativa» para ver su posición.",
			        ISBLANK(Pos), Nombre & " no tiene dato o no cumple los filtros de esta página.",
			        Nombre & " es la número " & Pos & " entre " & Total & " entidades en tasa de mora (1 = la más baja)."
			    )
		lineageTag: 8742b1a6-a2d5-a58b-1bdb-4ca442373a37

	/// Posición de la entidad de «Su entidad cooperativa» en tasa de riesgo (1 = la más baja).
	/// Universo: entidades con dato que cumplen los filtros de la página, sin el filtro de «Entidades a comparar».
	measure 'Ranking tasa riesgo' =
			VAR Sel = SELECTEDVALUE(dm_EntidadSeleccionada[CODIGO ENTIDAD])
			VAR ValorSel = CALCULATE([Tasa riesgo], REMOVEFILTERS(dm_Entidades[SIGLA]), dm_Entidades[CODIGO ENTIDAD] = Sel)
			VAR Universo =
			    FILTER(
			        CALCULATETABLE(
			            ADDCOLUMNS(VALUES(dm_Entidades[CODIGO ENTIDAD]), "@v", [Tasa riesgo]),
			            REMOVEFILTERS(dm_Entidades[SIGLA])
			        ),
			        NOT ISBLANK([@v])
			    )
			RETURN
			    IF(NOT ISBLANK(Sel) && NOT ISBLANK(ValorSel), COUNTROWS(FILTER(Universo, [@v] < ValorSel)) + 1)
