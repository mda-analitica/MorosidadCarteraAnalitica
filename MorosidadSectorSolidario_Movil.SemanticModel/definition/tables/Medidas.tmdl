	/// Verdadero cuando el usuario tocó una sola línea de crédito en una gráfica de barras (filtro cruzado sobre dm_Cuentas[Línea]).
	measure 'Hay línea seleccionada' = ISFILTERED(dm_Cuentas[Línea]) && HASONEVALUE(dm_Cuentas[Línea])
		lineageTag: 33e8d8ad-b179-03cd-2f95-09bfbf536c37

	/// Saldo en mora de la entidad seleccionada; vacío si no hay una línea seleccionada.
	measure 'Detalle saldo en mora' = IF([Hay línea seleccionada], [Saldo en mora con entidad seleccionada])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: c03097f0-416c-aa7f-c6ae-4806846aa1e5

	/// Tasa de mora de la entidad seleccionada; vacía si no hay una línea seleccionada.
	measure 'Detalle tasa mora' = IF([Hay línea seleccionada], [Tasa mora con entidad seleccionada])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: abe8c827-3e0b-9aa9-dd5a-bb3d203c51eb

	/// Saldo en riesgo (B a E) de la entidad seleccionada; vacío si no hay una línea seleccionada.
	measure 'Detalle saldo en riesgo' = IF([Hay línea seleccionada], [Saldo en riesgo con entidad seleccionada])
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: b0aa7729-4939-57cc-25cf-b58c622ab53c

	/// Tasa de riesgo de la entidad seleccionada; vacía si no hay una línea seleccionada.
	measure 'Detalle tasa riesgo' = IF([Hay línea seleccionada], [Tasa riesgo con entidad seleccionada])
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 1aa80ec5-333e-e60d-5061-8031a8a30b19

	/// Título del detalle de mora, o la invitación a tocar una línea cuando no hay selección.
	measure 'Mensaje detalle mora' = IF([Hay línea seleccionada], "Mora de " & SELECTEDVALUE(dm_Cuentas[Línea]) & " por días de vencimiento", "Toca una línea de crédito en la gráfica de arriba para ver el detalle")
		lineageTag: feba3d6b-c097-c922-51ef-16ba15022489

	/// Título del detalle de riesgo, o la invitación a tocar una línea cuando no hay selección.
	measure 'Mensaje detalle riesgo' = IF([Hay línea seleccionada], "Riesgo de " & SELECTEDVALUE(dm_Cuentas[Línea]) & " por calificación", "Toca una línea de crédito en la gráfica de arriba para ver el detalle")
		lineageTag: 552e2c3a-cedd-5022-652f-8bf1e3efaeb7

	/// 1 si la entidad (Su entidad) está entre las elegidas en «Entidades a comparar». Filtra la lista del paso 2.
	measure 'Entidad está en comparadas' =
			VAR s = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA])
			RETURN INT(NOT ISEMPTY(FILTER(VALUES(dm_Entidades[SIGLA]), dm_Entidades[SIGLA] = s)))
		formatString: 0
		lineageTag: 8b1e4d2a-77c0-4e51-9a3e-21d9f0c4ab77

	/// Mes y año del último corte, con mayúscula inicial (ej. Agosto 2026). Para la franja de Inicio.
	measure 'Corte texto corto' =
			VAR t = FORMAT([Fecha de corte], "MMMM yyyy")
			RETURN UPPER(LEFT(t, 1)) & MID(t, 2, 50)
		lineageTag: b5068064-98bf-5301-a551-4a095fab27d2

	/// Fecha de publicación de la Supersolidaria en formato dd/mm/aaaa. Para la franja de Inicio.
	measure 'Fecha Supersolidaria corta' =
			VAR f = MAX('Fecha Supersolidaria'[Fecha publicación])
			RETURN IF(ISBLANK(f), "No disponible", FORMAT(f, "dd/MM/yyyy"))
		lineageTag: bd44a948-3d52-5dc4-bf49-d936e38ce2c9

	/// Número de entidades que reportaron en el último corte. Para la franja de Inicio.
	measure 'Cooperativas reportantes' =
			VAR f = [Fecha de corte]
			RETURN CALCULATE(DISTINCTCOUNT(tb_Balance[CODIGO ENTIDAD]), REMOVEFILTERS(), tb_Balance[Fecha reporte] = f)
		formatString: 0
		lineageTag: 13dfb6de-97c6-5c95-b550-ca1e078dc5c6

	/// Texto con cuántas entidades hay marcadas en 'Entidades a comparar' (página Benchmarking · filtros).
	measure 'Entidades seleccionadas texto' =
			VAR n = IF(ISFILTERED(dm_Entidades[SIGLA]), COUNTROWS(VALUES(dm_Entidades[SIGLA])), 0)
			RETURN SWITCH(TRUE(), n = 0, "Ninguna seleccionada", n = 1, "1 seleccionada (elige al menos 2)", n & " seleccionadas")
		lineageTag: 4c030f99-1479-56e2-9eb2-f4b5018b75f9

	/// Texto bajo el buscador de la página Entidad · filtros (ej. 167 cooperativas, en orden alfabético).
	measure 'Cooperativas en lista texto' = [Cooperativas reportantes] & " cooperativas, en orden alfabético"
		lineageTag: 7b38abf8-3d93-5902-9cff-16bd659cfe23

	/// Texto dinámico del botón 'Ver informe de …' en la página Entidad · filtros.
	measure 'Texto botón ver informe' = 
			VAR s = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA])
			RETURN IF(ISBLANK(s), "Elige una cooperativa", "Ver informe de " & s)
		lineageTag: cced7e4e-8ba5-556f-8d4e-aa1e2efc40bc

	/// Corte inmediatamente anterior al último (para comparar mes contra mes).
	measure 'Fecha corte anterior' = 
			VAR f = [Fecha de corte]
			RETURN CALCULATE(MAX(tb_Balance[Fecha reporte]), REMOVEFILTERS(), tb_Balance[Fecha reporte] < f)
		formatString: General Date
		lineageTag: e8a506f5-be24-5ae2-8737-13b938e87e73

	/// Mes del corte anterior, ej. jul 2026.
	measure 'Mes corte anterior texto' = 
			VAR d = [Fecha corte anterior]
			RETURN LEFT(FORMAT(d, "MMMM"), 3) & " " & YEAR(d)
		lineageTag: 4a2b9c33-c32b-55b4-b5e5-4b5707ca1ed8

	/// Línea bajo el título de Por sector.
	measure 'Corte encabezado texto' = "Datos con corte a " & FORMAT([Fecha de corte], "MMMM ""de"" yyyy")
		lineageTag: e291225f-eef8-5ccd-b58b-b2008652bbf0

	/// Título de la sección de indicadores de Por sector.
	measure 'Resumen corte título' = "Resumen de " & FORMAT([Fecha de corte], "MMMM")
		lineageTag: 2a077cc9-3084-5689-991f-3eb0db0b9f15

	/// Tasa de riesgo en el último corte, con los filtros de entidad.
	measure 'Tasa riesgo corte' = 
			VAR f = [Fecha de corte]
			RETURN CALCULATE([Tasa riesgo], REMOVEFILTERS(Calendario), tb_Balance[Fecha reporte] = f)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
