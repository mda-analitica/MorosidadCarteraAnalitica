	measure 'Saldo en riesgo sin filtros' =
			
			CALCULATE(
			    SUM(tb_Balance[VALOR EN PESOS]),
			    FILTER(
			        dm_Cuentas,
			        NOT(ISBLANK(dm_Cuentas[Línea])) &&
			        dm_Cuentas[Tipo] = "Riesgo"  &&
			        dm_Cuentas[Estado] = "VERDADERO"
			    ),
			    dm_Entidades[SIGLA] = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA])
			)
		formatString: 0
		lineageTag: 838caf5c-c1be-4344-b173-f19b60cd7ab2

	measure 'Saludo de bienvenida' = ```
			
			VAR Hour = HOUR(NOW())
			VAR Greeting =
			    SWITCH(
			        TRUE(),
			        Hour >= 0 && Hour < 5, "Buenas noches",
			        Hour >= 5 && Hour < 12, "Buenos días",
			        Hour >= 12 && Hour < 18, "Buenas tardes",
			        Hour >= 18 && Hour < 24, "Buenas noches"
			    )
			RETURN
			    Greeting & " - " & [Nombre de usuario]
			
			```
		lineageTag: 031bd601-d882-41e3-9db7-94905fc5584e

	measure 'Nombre de usuario' =
			
			VAR FullUserName = USERNAME()
			VAR CleanName = LEFT(FullUserName, FIND("\", FullUserName) - 1)
			VAR CapitalizedName = UPPER(LEFT(CleanName, 1)) & LOWER(MID(CleanName, 2, LEN(CleanName) - 1))
			RETURN CapitalizedName
		lineageTag: eefe523f-778f-4f53-8f63-a654592a24fc

	measure Saldo = CALCULATE(SUM(tb_Balance[VALOR EN PESOS]))
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3deb1b1f-69ba-4bf0-9a0d-7661fc6e9846

	measure 'Saldo en mora con entidad seleccionada' =
			
			CALCULATE(
			    SUM(tb_Balance[VALOR EN PESOS]),
			    FILTER(
			        dm_Cuentas,
			        NOT(ISBLANK(dm_Cuentas[Línea])) &&
			        dm_Cuentas[Tipo] = "Mora" &&
			        dm_Cuentas[Estado] = "VERDADERO"
			    ),
			    TREATAS(VALUES(dm_EntidadSeleccionada[CODIGO ENTIDAD]), tb_Balance[CODIGO ENTIDAD])
			)
