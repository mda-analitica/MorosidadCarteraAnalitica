table Medidas
	lineageTag: 83f8f553-7f23-49bd-9b3a-b9ee44617fb2

	measure 'Saldo en riesgo' =
			
			CALCULATE(
			    SUM(tb_Balance[VALOR EN PESOS]),
			    FILTER(
			        dm_Cuentas,
			        NOT(ISBLANK(dm_Cuentas[Línea])) &&
			        dm_Cuentas[Tipo] = "Riesgo"  &&
			        dm_Cuentas[Estado] = "VERDADERO"
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d2072960-139c-4534-836e-64ad45a79ee8

	measure 'Saldo en mora' =
			
			CALCULATE(
			    SUM(tb_Balance[VALOR EN PESOS]),
			    FILTER(
			        dm_Cuentas,
			        NOT(ISBLANK(dm_Cuentas[Línea])) &&
			        dm_Cuentas[Tipo] = "Mora" &&
			        dm_Cuentas[Estado] = "VERDADERO"
			    )
			)
		formatString: 0.00
		lineageTag: d1d9bac3-7c1c-4835-b17c-265b0006f214

	measure Riesgo/Mora = DIVIDE([Saldo en riesgo], [Saldo en mora], BLANK())
		lineageTag: 4ccb0327-fb85-4946-a84f-84df5e95ce98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Saldo total' =
			CALCULATE(
			    SUM(tb_Balance[VALOR EN PESOS]),
			    FILTER(
			        ALL(dm_Cuentas),
			        dm_Cuentas[Tipo] = "Riesgo"
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 672bd395-8f50-48a6-99d7-d7533acda709

	measure 'Tasa mora' = DIVIDE([Saldo en mora], [Saldo total], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: fdc7223e-ff9d-4192-99c3-f916614670d7

	measure 'Tasa riesgo' = DIVIDE([Saldo en riesgo], [Saldo total], 0)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 66b4a2bf-7a9a-4c40-816f-08c7a018ea26

	measure 'Ranking Mora' = RANKX(ALL(dm_Entidades[SIGLA]), [Tasa mora])
		formatString: 0
		lineageTag: 2e9adb90-4fba-4519-a19c-1bdfbb4994a7

	measure 'Color barra seleccionada' =
			IF(SELECTEDVALUE(dm_Entidades[SIGLA]) = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA]), "#FF8C42",  // Amarillo
			    "#1E88E5") //Azul
		lineageTag: 5bdabf19-95f4-438b-b656-c8e64f87d506

	measure 'Tasa mora sin filtros' = CALCULATE([Tasa mora], ALL(dm_Entidades[SIGLA]), dm_Entidades[SIGLA] = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA]))
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 2c4bc232-4d6d-4d21-ae66-940a5094d23e

