	measure 'Tasa riesgo sin filtros' = ```
			CALCULATE(
			    [Tasa riesgo], 
			        ALL(dm_Entidades[SIGLA]), 
			        dm_Entidades[SIGLA] = SELECTEDVALUE(dm_EntidadSeleccionada[SIGLA])
